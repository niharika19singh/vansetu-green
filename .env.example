# =============================================================================
# VanSetu — Urban Climate Action Intelligence (HackCBS 9.0 Configuration)
# Copy to .env (or backend/.env & frontend/.env) for local overrides.
# Do NOT commit real API keys or secrets to version control.
# =============================================================================

# --- Backend Server ---
HOST=0.0.0.0
PORT=7860
DEBUG=false

# --- Geospatial Data Paths ---
DATA_DIR=data
NDVI_FILE=delhi_ndvi_10m.tif
LST_FILE=delhi_lst_modis_daily_celsius.tif
ROADS_CACHE_FILE=delhi_roads_cached.geojson
DISTRICTS_FILE=delhi_districts.json

# --- External Air Quality Telemetry (Optional) ---
WAQI_TOKEN=
OPENAQ_API_KEY=

# --- YugabyteDB / Meko MCP Context Layer (Track A — Open Project) ---
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_API_KEY=
# Build-time datapack (Coding agents ONLY — never accessed by runtime product agents)
MEKO_BUILD_DATAPACK_ID=
# Runtime datapacks (Product agents ONLY — never accessed by coding agents)
MEKO_PROJECT_DATAPACK_ID=
MEKO_KNOWLEDGE_DATAPACK_ID=
MEKO_DECISIONS_DATAPACK_ID=

# --- MLH: Google Gemini API (Function-Calling Climate Agent) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- MLH: Tiger Data / TimescaleDB (Environmental Time-Series Layer) ---
TIGER_DATA_URL=
TIMESCALE_SERVICE_URL=

# --- MLH: DigitalOcean Spaces (Durable S3-Compatible Geospatial Storage) ---
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=blr1
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=

# --- Frontend ---
VITE_API_URL=http://localhost:7860
