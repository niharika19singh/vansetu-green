# =============================================================================
# VanSetu GreenTech — Environment Configuration Template
# Copy to .env (or backend/.env & frontend/.env) for local overrides.
# Do NOT commit real API keys or secrets to version control.
# =============================================================================

# --- Backend Server ---
HOST=0.0.0.0
PORT=7860
DEBUG=false

# --- Geospatial Data Paths ---
DATA_DIR=data
NDVI_FILE=delhi_ndvi_10m.tif
LST_FILE=delhi_lst_modis_daily_celsius.tif
ROADS_CACHE_FILE=delhi_roads_cached.geojson
DISTRICTS_FILE=delhi_districts.json

# --- External Air Quality Telemetry (Optional) ---
# When unset or unreachable, the AQI service deterministically falls back to
# historical CPCB reference baselines and explicitly labels data_mode="historical_fallback_baseline".
WAQI_TOKEN=
OPENAQ_API_KEY=

# --- Frontend ---
VITE_API_URL=http://localhost:7860
